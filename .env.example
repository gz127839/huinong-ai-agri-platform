# ============ 慧农 AI 环境变量模板 ============
# 复制本文件为 .env（或直接设置系统环境变量）后按需修改。
# 所有变量均有默认值，不配置也能正常运行。

# ---- 服务 ----
PORT=5000                      # 服务端口（被占用时启动器自动+1）
FLASK_DEBUG=0                  # 调试模式：开发可设 1，正式部署必须 0
SECRET_KEY=change-me-to-a-random-string   # 会话加密密钥，正式部署务必修改

# ---- AI 识别引擎 ----
# 主模型为本地 ONNX（ai_model/ 目录），离线可用，无需任何 Key。
# 以下两项仅在想把识别结果转发给自建服务复核时才需要：
# AI_API_URL=https://your-ai-service/recognize
# AI_API_KEY=your-token

# ---- 农技问答 / 农业智能体（LLM）----
# 默认走 WorkBuddy 云服务免密钥通道（见 llm_client.py 内置配置），无需填写任何 Key。
# 想换成自备的 OpenAI 兼容接口时，取消下面三行注释并填写（DeepSeek / 通义 / 智谱 / 中转均可）：
# AI_LLM_BASE_URL=https://api.deepseek.com/v1
# AI_LLM_API_KEY=sk-xxxx
# AI_LLM_MODEL=deepseek-chat
# 完全禁用云端大模型（只用内置规则规划器 / 知识库检索）时设 1：
# AI_LLM_DISABLE_CLOUD=1
